    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
